# Graph store: auto (Neo4j if reachable, else embedded JSON) | neo4j | embedded
KG_GRAPH_BACKEND=auto
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Triple extraction: spacy (local, default) | llm | hybrid
KG_EXTRACTOR=spacy
KG_SPACY_MODEL=en_core_web_sm

# Answer writer: auto = Ollama when it is running, else Groq when GROQ_API_KEY is set
# ollama | groq | openai (OpenAI-compatible endpoint) | none (answer from the PDF's sentences)
KG_ANSWER_LLM=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# GROQ_API_KEY=
# GROQ_ANSWER_MODEL=openai/gpt-oss-120b
# OPENAI_ANSWER_MODEL=gpt-4o-mini

# Where chunk / graph / active-document JSON state is written
# KG_STATE_DIR=kg_app/state

# Embeddings: auto (sentence-transformers bge-small) | local (hash fallback, no download)
KG_EMBEDDING_BACKEND=auto

# Optional: LLM extraction through any OpenAI-compatible endpoint (Ollama shown)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_TRIPLE_MODEL=mistral

# Optional: use the Hebbrix API instead of the local pipeline
# HEBBRIX_NATIVE_MODE=1
# HEBBRIX_API_KEY=
# HEBBRIX_BASE_URL=https://api.hebbrix.com/v1
